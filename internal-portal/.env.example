# =============================================================================
# IT Asset & Helpdesk Portal — Môi trường vận hành (.env.example)
# =============================================================================
# Copy file này thành .env và chỉnh sesuai môi trường. Bản .env thật không
# được đưa vào git (đã có trong .gitignore ở cả repo root lẫn internal-portal/).
#
# Quy ước tên biến
#   PORT_HOST / APP_PORT  — tách rõ port công bố (host) vs port app lắng (container)
#     → docker compose: '${PORT_HOST:-3000}:${APP_PORT:-3000}'
#     → app sẽ nghe tại process.env.APP_PORT === process.env.PORT (cả 2{equivalent}
#     → người dùng truy cập http://localhost:${PORT_HOST}
#   DATA_DIR / DATA_HOST_PATH — đường dẫn trong container vs thư mục bind trên host
#
# Caching: sau khi sửa file này, người dùng (kể cả compose) chỉ đọc đúng SANDBOX env;
#         nếu muốn sandbox khác, tạo .env.<env> riêng (form:sample/sea-demo1)


# --- 1. Cổng & mạng ---------------------------------------------------------
PORT_HOST=3000       # port công bố ra host    → http://localhost:${PORT_HOST}
APP_PORT=3000        # port app nghe TRONG container

# --- 2. Runtime / môi trường ------------------------------------------------
NODE_ENV=production  # 'production' | 'development'
TZ=Asia/Ho_Chi_Minh
DATA_DIR=/app/data   # thư mục chứa db.json + notifications.log TRONG container
DATA_HOST_PATH=./data        # thư mục host bind vào ${DATA_DIR}

# --- 3. Cảnh báo / webhook --------------------------------------------------
# Để trống (hoặc comment) = dùng mock: ghi xuống data/notifications.log
# Ví dụ sản xuất:
#  IT_WEBHOOK_URL=https://hooks.example.com/it-portal-alerts
IT_WEBHOOK_URL=

# --- 4. Bảo mật / CORS ------------------------------------------------------
# Mặc định '*' (cho phép mọi origin) → thích hợp khi chạy localhost hoặc đặt sau
# reverse proxy có thiết lập headers. Để siết, điền danh sách origin ngăn cách
# dấu phẩy, vd:
#   ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGINS=*

# --- 5. Vận hành / giới hạn container ----------------------------------------
# Giới hạn container khi deploy với thuộc tính 'deploy.resources.limits'
# (compose v2+; chỉ có hiệu lực khi chạy swarm mode hoặc bằng docker compose v2).
MEM_LIMIT=256m      # memory: 256m (đi kèm compose: deploy.resources.limits.memory)
CPU_LIMIT=1.0       # cpus: 1.0   (đi kèm compose: deploy.resources.limits.cpus)
LOG_MAX_SIZE=10m    # log file max size (docker logging driver: max-size)
LOG_MAX_FILE=3      # log file max số lượng (docker logging driver: max-file)
